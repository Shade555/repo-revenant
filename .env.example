# ==============================================================================
# RepoRevenant — Environment Configuration
# ==============================================================================

# Application URL
APP_URL=http://localhost:3000

# GitHub Intelligence (Optional - Public repos work without a token)
# Providing a token grants higher rate limits (5,000 req/hr vs 60 req/hr)
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Open-Weight AI Intelligence (Ollama / Gemma 3)
# Default model: gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# MongoDB Atlas Persistence (Optional for local development)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=repo_revenant

# Sentry Observability & Tracing (Optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
